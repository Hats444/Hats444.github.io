# Hats444 Portfolio Analytics — environment template
# Copy to .env for local scripts; Supabase secrets for edge functions.

# ── Supabase project (public on client — safe in js/config.js) ──
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# ── Edge function secrets (Supabase Dashboard → Edge Functions → Secrets) ──
# NEVER commit real values. Set via: supabase secrets set KEY=value

# Service role — server-side only (track-enter, presence, admin)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Admin dashboard password (plain, hashed at deploy — see README)
ADMIN_PASSWORD=change-me-strong-password

# SHA-256 hex of ADMIN_PASSWORD (generate: echo -n 'password' | sha256sum)
ADMIN_PASSWORD_HASH=

# HMAC secret for admin session tokens (random 32+ chars)
ADMIN_TOKEN_SECRET=generate-a-long-random-string

# Rate limit: seconds between enter events per visitor (default 30)
ENTER_DEBOUNCE_SECONDS=30
